# All options with their defaults. Uncomment a line to change it.
# Environment variables take precedence over this file.

## Server

# Listen address. Use 0.0.0.0:12104 to accept connections from other machines.
PODIMO_BIND_HOST="127.0.0.1:12104"

# Public address used in the feed URLs the web form shows. Episode links inside
# a feed use the address that feed was requested on, with PODIMO_PROTOCOL when
# that address is this one.
PODIMO_HOSTNAME="localhost:12104"
# "https" when running behind a TLS reverse proxy.
#PODIMO_PROTOCOL="http"
# Set to false to always link episodes to PODIMO_PROTOCOL://PODIMO_HOSTNAME, for
# a reverse proxy that rewrites the Host header.
#STREAM_LINKS_FROM_REQUEST=true

## Feeds

# Episode file format:
# - "m4a": Podimo's AAC audio repackaged; original quality, almost no CPU.
#   Each episode is fetched in full first, then kept in TMPDIR for an hour.
# - "mp3": re-encoded to 128 kbps; plays everywhere, ~1 CPU core per download.
#STREAM_FORMAT=m4a

# Let podcast directories (Apple Podcasts, Pocket Casts, ...) index your feeds.
#PUBLIC_FEEDS=false

## Credentials

# Personal instance: log in with the account below instead of credentials in
# the feed URL. Don't enable this on an instance shared with other people.
#LOCAL_CREDENTIALS=false
#PODIMO_EMAIL="you@example.com"
#PODIMO_PASSWORD="secret"
# The account's region and locale, as offered on the web form. Used by the
# library, and by feeds unless their URL has ?region= and ?locale=.
#PODIMO_REGION="nl"
#PODIMO_LOCALE="nl-NL"

## Cloudflare

# Podimo's API often blocks data center IPs. Set at most one of these to route
# API calls through a proxy; a home connection usually doesn't need any.
#HTTP_PROXY="http://proxy.example.com:8080"
# https://www.zenrows.com
#ZENROWS_API="API_KEY"
# https://www.scraperapi.com
#SCRAPER_API="API_KEY"

## Caching (durations in seconds)

#CACHE_DIR="./cache"
# Login tokens give full account access. Set to false on shared instances.
#STORE_TOKENS_ON_DISK=true
# 5 days.
#TOKEN_CACHE_TIME=432000
# 6 hours: how quickly new episodes show up.
#PODCAST_CACHE_TIME=21600
# 7 days: file-size lookups for episodes that aren't HLS.
#HEAD_CACHE_TIME=604800
# 10 minutes: signed audiobook URLs expire, so keep this short.
#AUDIOBOOK_AUDIO_CACHE_TIME=600

## Audiobook library

# Downloads audiobooks to LIBRARY_DIR as <Author>/<Title>/ with the audio,
# cover and metadata, readable by Audiobookshelf. Requires LOCAL_CREDENTIALS.
#ENABLE_LIBRARY=false
#LIBRARY_DIR="./library"

## Other

# Podcast or feed IDs to block; see .block-list.example.
#BLOCK_LIST_FILE="./.block-list"
# Log as JSON instead of text.
#PODIMO_LOG_JSON=false
# Verbose request logging.
DEBUG=false
